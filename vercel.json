{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/smashegg/ggc", "permanent": false },
    { "source": "/index", "destination": "/smashegg/ggc", "permanent": false }
  ],
  "rewrites": [
    { "source": "/smashegg/ggc", "destination": "/index.html" },
    { "source": "/smashegg/ggc/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
